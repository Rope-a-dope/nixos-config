# Everforest Dark Medium — Kakoune
# Palette inspired by sainnhe/everforest

set-face global Default           "rgb:d3c6aa,rgb:2d353b"
set-face global PrimarySelection  "rgb:2d353b,rgb:a7c080"
set-face global SecondarySelection "rgb:2d353b,rgb:83c092"
set-face global PrimaryCursor     "rgb:2d353b,rgb:d3c6aa"
set-face global SecondaryCursor   "rgb:2d353b,rgb:a7c080"
set-face global LineNumbers       "rgb:859289,rgb:343f44"
set-face global LineNumberCursor  "rgb:d3c6aa,rgb:3d484d"
set-face global MenuForeground    "rgb:d3c6aa,rgb:343f44"
set-face global MenuBackground    "rgb:859289,rgb:343f44"
set-face global MenuInfo          "rgb:a7c080,rgb:343f44"
set-face global Information       "rgb:d3c6aa,rgb:343f44"
set-face global Error             "rgb:e67e80,rgb:343f44"
set-face global StatusLine        "rgb:d3c6aa,rgb:343f44"
set-face global StatusLineMode    "rgb:2d353b,rgb:a7c080"
set-face global StatusLineInfo    "rgb:d3c6aa,rgb:343f44"
set-face global StatusLineValue   "rgb:a7c080,rgb:343f44"
set-face global StatusCursor      "rgb:2d353b,rgb:d3c6aa"
set-face global Prompt            "rgb:d3c6aa,rgb:343f44"
set-face global MatchingChar      "rgb:2d353b,rgb:dbbc7f"
set-face global Whitespace        "rgb:475258"
set-face global BufferPadding     "rgb:859289,rgb:343f44"

set-face global Keyword           "rgb:e67e80"
set-face global Control           "rgb:e67e80"
set-face global Operator          "rgb:e69875"
set-face global String            "rgb:a7c080"
set-face global Value             "rgb:d699b6"
set-face global Number            "rgb:d699b6"
set-face global Type              "rgb:dbbc7f"
set-face global Function          "rgb:a7c080"
set-face global Variable          "rgb:d3c6aa"
set-face global Module            "rgb:83c092"
set-face global Attribute         "rgb:e69875"
set-face global Comment           "rgb:859289"
set-face global Documentation     "rgb:859289"
set-face global Meta              "rgb:7fbbb3"
set-face global Builtin           "rgb:7fbbb3"
set-face global Label             "rgb:e67e80"
set-face global DiagnosticError   "rgb:e67e80"
set-face global DiagnosticWarning "rgb:dbbc7f"
set-face global DiagnosticInfo    "rgb:7fbbb3"

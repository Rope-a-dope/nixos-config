# Tokyo Night Night — Kakoune
# Palette inspired by folke/tokyonight.nvim

set-face global Default            "rgb:a9b1d6,rgb:1a1b26"
set-face global PrimarySelection   "rgb:1a1b26,rgb:3d59a1"
set-face global SecondarySelection "rgb:1a1b26,rgb:28344a"
set-face global PrimaryCursor      "rgb:1a1b26,rgb:c0caf5"
set-face global SecondaryCursor    "rgb:1a1b26,rgb:7aa2f7"
set-face global LineNumbers        "rgb:565f89,rgb:1f2335"
set-face global LineNumberCursor   "rgb:c0caf5,rgb:292e42"
set-face global MenuForeground     "rgb:c0caf5,rgb:1f2335"
set-face global MenuBackground     "rgb:565f89,rgb:1f2335"
set-face global MenuInfo           "rgb:7dcfff,rgb:1f2335"
set-face global Information        "rgb:c0caf5,rgb:1f2335"
set-face global Error              "rgb:f7768e,rgb:1f2335"
set-face global StatusLine         "rgb:a9b1d6,rgb:1f2335"
set-face global StatusLineMode     "rgb:1a1b26,rgb:7aa2f7"
set-face global StatusLineInfo     "rgb:a9b1d6,rgb:1f2335"
set-face global StatusLineValue    "rgb:7dcfff,rgb:1f2335"
set-face global StatusCursor       "rgb:1a1b26,rgb:c0caf5"
set-face global Prompt             "rgb:c0caf5,rgb:1f2335"
set-face global MatchingChar       "rgb:1a1b26,rgb:e0af68"
set-face global Whitespace          "rgb:414868"
set-face global BufferPadding      "rgb:565f89,rgb:1f2335"

set-face global Keyword            "rgb:bb9af7"
set-face global Control            "rgb:f7768e"
set-face global Operator           "rgb:89ddff"
set-face global String             "rgb:9ece6a"
set-face global Value              "rgb:ff9e64"
set-face global Number             "rgb:ff9e64"
set-face global Type               "rgb:2ac3de"
set-face global Function           "rgb:7aa2f7"
set-face global Variable           "rgb:c0caf5"
set-face global Module             "rgb:bb9af7"
set-face global Attribute          "rgb:7dcfff"
set-face global Comment            "rgb:565f89"
set-face global Documentation      "rgb:565f89"
set-face global Meta               "rgb:e0af68"
set-face global Builtin            "rgb:73daca"
set-face global Label              "rgb:f7768e"
set-face global DiagnosticError    "rgb:f7768e"
set-face global DiagnosticWarning  "rgb:e0af68"
set-face global DiagnosticInfo     "rgb:7dcfff"

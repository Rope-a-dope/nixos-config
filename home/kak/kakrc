# AutoPairs
enable-auto-pairs

# SmartTab: spaces for indentation and alignment
hook global BufOpenFile .* expandtab
hook global BufNewFile .* expandtab

# popup.kak
evaluate-commands %sh{kak-popup init}

# Lua support and Peneira fuzzy finder
require-module luar
set-option global luar_interpreter luajit
require-module peneira

# Theme
colorscheme everforest

set-face global crosshairs_column default,rgb:3d484d
set-option global kakeidoscope_faces \
  rgb:e67e80 rgb:dbbc7f rgb:a7c080 rgb:7fbbb3 rgb:83c092 rgb:d699b6

hook global WinCreate .* kakeidoscope-enable-window
